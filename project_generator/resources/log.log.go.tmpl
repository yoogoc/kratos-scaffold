package log

import (
	"log/slog"

	"github.com/google/wire"
	"github.com/yoogoc/kratos-kit/appinfo"
	kitlog "github.com/yoogoc/kratos-kit/log"
)

// log level: debug info warn error dpanic panic fatal

type VersionString = appinfo.Version
type NameString = appinfo.Name

var ProviderSet = wire.NewSet(NewKratosLogger)

func NewKratosLogger(name NameString, version VersionString) *slog.Logger {
	return kitlog.New(kitlog.Options{Name: string(name), Version: string(version), Level: "info", FilterKeys: []string{"password"}})
}
