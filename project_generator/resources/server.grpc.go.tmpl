package server

import (
	"log/slog"

	"github.com/go-kratos/kratos/v3/transport/grpc"
	kitmiddleware "github.com/yoogoc/kratos-kit/middleware"
	"{{.AppPkgPath}}/internal/conf"
	"{{.AppPkgPath}}/internal/service"
	v1 "{{.ApiPkgPath}}"
)

// NewGRPCServer new a gRPC server.
func NewGRPCServer(bootstrap *conf.Bootstrap, logger *slog.Logger, greeter *service.GreeterService) *grpc.Server {
	c := bootstrap.Server
	var opts = []grpc.ServerOption{
		grpc.Middleware(kitmiddleware.GRPC(logger)...),
	}
	if c.Grpc.Network != "" {
		opts = append(opts, grpc.Network(c.Grpc.Network))
	}
	if c.Grpc.Addr != "" {
		opts = append(opts, grpc.Address(c.Grpc.Addr))
	}
	if c.Grpc.Timeout != nil {
		opts = append(opts, grpc.Timeout(c.Grpc.Timeout.AsDuration()))
	}
	srv := grpc.NewServer(opts...)
	v1.RegisterGreeterServer(srv, greeter)
	return srv
}
