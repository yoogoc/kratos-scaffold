# OpenAPI v2 (swagger) spec, merged into a single openapi.swagger.json per service.
# Run with `-o openapi/<service>` and `--path api/<service>` (see `just openapi`).
version: v2
managed:
  enabled: false
plugins:
  - local: [go, tool, protoc-gen-openapiv2]
    out: .
    opt:
      - allow_merge=true
      - include_package_in_tags=false
      - merge_file_name=openapi
