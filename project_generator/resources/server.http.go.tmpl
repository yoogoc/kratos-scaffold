package server

import (
	"log/slog"
	stdhttp "net/http"

	"github.com/go-kratos/kratos/v3/transport/http"
	"github.com/gorilla/handlers"
	kitmiddleware "github.com/yoogoc/kratos-kit/middleware"
	"{{.AppPkgPath}}/internal/conf"
	"{{.AppPkgPath}}/internal/service"
	v1 "{{.ApiPkgPath}}"

	_ "github.com/go-kratos/kratos/contrib/encoding/json/v3"
)

// NewHTTPServer new an HTTP server.
func NewHTTPServer(c *conf.Server, logger *slog.Logger, greeter *service.GreeterService) *http.Server {
	var opts = []http.ServerOption{
		http.Middleware(kitmiddleware.HTTP(logger)...),
		http.Filter(handlers.CORS(
			handlers.AllowedHeaders([]string{"X-Requested-With", "Content-Type", "Authorization"}),
			handlers.AllowedMethods([]string{"GET", "POST", "PUT", "HEAD", "OPTIONS", "DELETE", "CONNECT", "TRACE", "PATCH"}),
			handlers.AllowedOrigins([]string{"*"}),
		)),
	}
	if c.Http.Network != "" {
		opts = append(opts, http.Network(c.Http.Network))
	}
	if c.Http.Addr != "" {
		opts = append(opts, http.Address(c.Http.Addr))
	}
	if c.Http.Timeout != nil {
		opts = append(opts, http.Timeout(c.Http.Timeout.AsDuration()))
	}
	srv := http.NewServer(opts...)
	v1.RegisterGreeterHTTPServer(srv, greeter)
	health(srv)

	return srv
}

func health(s *http.Server) {
	s.HandleFunc("/health", func(w stdhttp.ResponseWriter, r *stdhttp.Request) {
		w.WriteHeader(200)
		_, _ = w.Write([]byte("OK"))
	})
}
