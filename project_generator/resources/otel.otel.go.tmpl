package otel

import (
	"context"

	"{{.AppPkgPath}}/internal/conf"

	"github.com/google/wire"
	"go.opentelemetry.io/otel/trace"
	kitotel "github.com/yoogoc/kratos-kit/otel"
)

var ProviderSet = wire.NewSet(NewTracerProvider)

func NewTracerProvider(c *conf.Trace) (trace.TracerProvider, func(), error) {
	endpoint := ""
	if c != nil { endpoint = c.Endpoint }
	provider, err := kitotel.New(context.Background(), kitotel.Options{
		Endpoint: endpoint, ServiceName: "{{.ServiceName}}", Insecure: true,
	})
	if err != nil {
		return nil, nil, err
	}

	return provider, func() { _ = provider.Shutdown(context.Background()) }, nil
}
