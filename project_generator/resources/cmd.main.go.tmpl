{{- /*gotype: github.com/yoogoc/kratos-scaffold/project_generator.CmdTmpl*/ -}}
package main

import (
	"fmt"
	"{{.AppPkgPath}}/internal/conf"
	defaultconfigs "{{.ProjectPkgPath}}/configs"
	ilog "{{.AppPkgPath}}/internal/log"
	"os"

	"github.com/spf13/cobra"
	kitconfig "github.com/yoogoc/kratos-kit/config/loader"
)

// go build -ldflags "-X main.Version=x.y.z"
var (
	// Name is the name of the compiled software.
	Name = "{{.ServiceName}}"
	// Version is the version of the compiled software.
	Version string

	flagconf string
	closeConf func() error
)

type RootCommand cobra.Command

func main() {
	cmd, cleanup, err := initApp(ilog.NameString(Name), ilog.VersionString(Version))
	if err != nil {
		_, _ = fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	defer func() {
		cleanup()
		if closeConf != nil {
			_ = closeConf()
		}
	}()

	if err = cmd.Execute(); err != nil {
		_, _ = fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func newConf(rootCmd *RootCommand) *conf.Bootstrap {
	flags := (*cobra.Command)(rootCmd).PersistentFlags()
	flags.StringVarP(&flagconf, "config", "c", "", "additional config file or directory")
	var bc conf.Bootstrap
	_ = flags.Parse(os.Args[1:])
	defaultRoots := []string{"default"}
	localRoots := []string{"./configs/local"}
{{- if .IsSubMono }}
	defaultRoots = append(defaultRoots, "default/{{.Name}}")
	localRoots = append(localRoots, "./configs/local/{{.Name}}")
{{- end }}
	closeConfig, err := kitconfig.Load(&bc, kitconfig.Options{
		Defaults: defaultconfigs.DefaultFS,
		DefaultRoots: defaultRoots,
		LocalRoots: localRoots,
		ExplicitPath: flagconf,
		EnvPrefix: "KRATOS_",
	})
	if err != nil {
		panic(err)
	}
	closeConf = closeConfig
	return &bc
}

func newDataConf(bc *conf.Bootstrap) *conf.Data {
	return bc.Data
}

func newServerConf(bc *conf.Bootstrap) *conf.Server {
	return bc.Server
}

func newTraceConf(bc *conf.Bootstrap) *conf.Trace {
	return bc.Trace
}

func newRootCmd() *RootCommand {
	root := &RootCommand{
		Short:              "assign service",
		Long:               "assign service",
		FParseErrWhitelist: cobra.FParseErrWhitelist{UnknownFlags: true},
		Run: func(cmd *cobra.Command, args []string) {
			_ = cmd.Help()
		},
	}

	return root
}

{{- if .IsBff }}
func newCmd(root *RootCommand, server *ServerCommand) *cobra.Command {
	(*cobra.Command)(root).AddCommand(
		(*cobra.Command)(server),
	)
	return (*cobra.Command)(root)
}
{{- else }}
func newCmd(root *RootCommand, server *ServerCommand, migrate *MigrateCommand) *cobra.Command {
	(*cobra.Command)(root).AddCommand(
		(*cobra.Command)(server),
		(*cobra.Command)(migrate),
	)
	return (*cobra.Command)(root)
}
{{- end }}
